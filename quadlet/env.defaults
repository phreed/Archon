# Environment variables for Archon quadlet containers
# Copy these variables to your .env file or rename this file to .env

# Supabase Configuration (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key-here

# OpenAI Configuration (Optional)
OPENAI_API_KEY=

# Logging Configuration
LOG_LEVEL=INFO
LOGFIRE_TOKEN=

# Service Discovery
SERVICE_DISCOVERY_MODE=docker_compose

# Port Configuration
ARCHON_SERVER_PORT=8181
ARCHON_MCP_PORT=8051
ARCHON_AGENTS_PORT=8052
ARCHON_UI_PORT=3737
ARCHON_DOCS_PORT=3838

# Host Configuration
ARCHON_HOST=localhost
HOST=localhost

# Agents Configuration
AGENTS_ENABLED=false
AGENTS_SERVICE_URL=http://archon-agents:8052

# MCP Configuration
API_SERVICE_URL=http://archon-server:8181
TRANSPORT=sse

# Frontend Configuration
DOCKER_ENV=true
PROD=false
VITE_ALLOWED_HOSTS=
VITE_ARCHON_SERVER_PORT=8181
VITE_SHOW_DEVTOOLS=false
